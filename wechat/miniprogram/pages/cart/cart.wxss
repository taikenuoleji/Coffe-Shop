/* cart.wxss - 购物车页面样式 */

.cart-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 64rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.go-shopping {
  padding: 20rpx 64rpx;
  background-color: #C67C4E;
  border-radius: 40rpx;
}

.go-shopping text {
  font-size: 28rpx;
  color: #fff;
}

/* 加载中 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #C67C4E;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #A2A2A2;
}

/* 购物车内容 */
.cart-content {
  padding: 24rpx;
}

/* 头部 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.cart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.clear-btn {
  font-size: 26rpx;
  color: #FF6B6B;
}

/* 商家信息 */
.shop-info {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.shop-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.shop-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 商品列表 */
.goods-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.goods-item:last-child {
  border-bottom: none;
}

/* 复选框 */
.checkbox-wrapper {
  padding: 16rpx;
  margin-right: 8rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background-color: #C67C4E;
  border-color: #C67C4E;
}

.check-icon {
  width: 20rpx;
  height: 12rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  margin-bottom: 4rpx;
}

/* 商品图片 */
.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  margin-right: 20rpx;
}

/* 商品信息 */
.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-category {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.goods-price-row {
  display: flex;
  align-items: center;
}

.goods-price {
  font-size: 30rpx;
  color: #C67C4E;
  font-weight: 600;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn text {
  font-size: 28rpx;
  color: #333;
}

.qty-btn.minus {
  opacity: 0.6;
}

.qty-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

/* 全选 */
.select-all {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.select-all-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
}

/* 合计 */
.total-wrapper {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-right: 24rpx;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #C67C4E;
  font-weight: 600;
}

/* 结算按钮 */
.checkout-btn {
  padding: 24rpx 48rpx;
  background-color: #C67C4E;
  border-radius: 40rpx;
}

.checkout-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.checkout-btn.disabled {
  background-color: #ccc;
}

.checkout-btn.disabled text {
  color: #fff;
}
